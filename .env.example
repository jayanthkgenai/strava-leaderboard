# ── Strava API ──────────────────────────────────────────────
# From https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret

# ── App Config ───────────────────────────────────────────────
# Full public URL of your deployed app (no trailing slash)
# Local dev: http://localhost:3000
# Production: https://your-app.onrender.com
BASE_URL=http://localhost:3000

# Random secret for signing sessions — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_random_string

# ── Upstash Redis ────────────────────────────────────────────
# From https://console.upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ── Runtime ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
